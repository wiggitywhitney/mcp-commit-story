# Example configuration file for MCP Commit Story
# Copy this file to .mcp-commit-storyrc.yaml in your project root

# Journal configuration
journal:
  # Directory for journal files (relative to project root)
  path: journal/

# Git configuration
git:
  # Files to exclude from git processing
  exclude_patterns:
    - journal/**
    - .mcp-commit-storyrc.yaml

# AI configuration
ai:
  # OpenAI API key - use environment variable interpolation for security
  openai_api_key: "${OPENAI_API_KEY}"

# Telemetry configuration
telemetry:
  # Enable/disable telemetry collection
  enabled: false